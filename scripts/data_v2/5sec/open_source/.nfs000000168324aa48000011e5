MODEL="OpenGVLab/InternVL3_5-8B"
TASK_NAME="longvid-reasoning-eval_v2_5sec"
OUTPUT_DIR="/nas2/longvideo_eval/longvid-reasoning-eval/results/data_v2/internvl3p5_8b/longvid_reasoning_eval_v2_5sec"
GPUS="0,1,2,3"
NUM_PROCESSES=4
BATCH_SIZE=1
PYTHON="/nas2/edwin/miniconda/envs/internvl/bin/python"

export HF_HUB_OFFLINE=1

export CUDA_VISIBLE_DEVICES="$GPUS"
export NCCL_P2P_DISABLE=1
export HF_HOME="/nas2/edwin/lmms-eval/.cache/huggingface"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SCRIPT_DIR"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"
TASKS_INCLUDE="${LMMS_EVAL_TASKS_PATH:-$REPO_ROOT/lmms_eval/tasks}"

mkdir -p "$OUTPUT_DIR"

MODEL_ARGS="pretrained=${MODEL},modality=video,device_map=auto"

export LMMS_EVAL_LAUNCHER="accelerate"

$PYTHON -m accelerate.commands.launch --num_processes=${NUM_PROCESSES} -m lmms_eval \
    --include_path "${TASKS_INCLUDE}" \
    --model internvl3_5 \
    --model_args "${MODEL_ARGS}" \
    --tasks ${TASK_NAME} \
    --batch_size ${BATCH_SIZE} \
    --log_samples \
    --log_samples_suffix internvl3_8b_v2_5sec \
    --output_path ${OUTPUT_DIR}
