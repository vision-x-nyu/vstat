dataset_path: json
dataset_kwargs:
  data_files:
    test: /nas2/longvideo_eval/blender/data/5min/merged_qa.json
task: longvid-reasoning-eval_5min
test_split: test
output_type: generate_until
doc_to_visual: !function utils.longvid_reasoning_eval_5min_doc_to_visual
doc_to_text: !function utils.longvid_reasoning_eval_5min_doc_to_text
doc_to_target: !function utils.longvid_reasoning_eval_5min_doc_to_target
process_results: !function utils.longvid_reasoning_eval_5min_process_results
metric_list:
  - metric: accuracy
    aggregation: !function utils.longvid_reasoning_eval_5min_aggregate_accuracy
    higher_is_better: true
generation_kwargs:
  max_new_tokens: 64
  temperature: 0
  do_sample: false
lmms_eval_specific_kwargs:
  default:
    pre_prompt: ""
    post_prompt: ""
metadata:
  version: 0.0
